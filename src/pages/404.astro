---
import Layout from '../components/Layout.astro';
import Arrow from '../components/Arrow.astro';
---

<Layout
  title="Página no encontrada · Tulio Contreras"
  description="Esta dirección no existe en el portafolio de Tulio Contreras. Vuelve al inicio para explorar los proyectos y las demos de desarrollo Full-Stack."
  noindex
>
  <section class="not-found">
    <h1>
      Esta página
      <br />
      no está aquí.
    </h1>
    <p>Puedes volver al portafolio para explorar mis proyectos.</p>
    <a class="button button-dark" href="/">
      Volver al inicio <Arrow />
    </a>
  </section>
</Layout>
