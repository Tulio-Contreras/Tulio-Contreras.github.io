---
import Layout from '../../components/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import SoftwareLab from '../../components/SoftwareLab.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}
const { project, next } = Astro.props;
const url = new URL(`/proyectos/${project.slug}/`, Astro.site).href;
const schema = [
  {
    '@type': 'SoftwareSourceCode',
    '@id': `${url}#source`,
    name: project.name,
    description: project.summary,
    codeRepository: project.repository,
    programmingLanguage: [...project.languages],
    author: { '@id': `${Astro.site}#tulio` },
    url,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: Astro.site },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Proyectos',
        item: new URL('/proyectos/', Astro.site).href,
      },
      { '@type': 'ListItem', position: 3, name: project.name, item: url },
    ],
  },
];
---

<Layout title={project.seoTitle} description={project.summary} schema={schema}>
  <header class="case-header">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/proyectos/">Proyectos</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>
    <h1>
      {project.name}: {project.title}
    </h1>
    <p class="case-summary">{project.summary}</p>
    <div class="case-actions">
      <a
        class="button button-ink"
        href={project.repository}
        target="_blank"
        rel="noopener noreferrer"
      >
        Explorar el repositorio <Arrow />
      </a>
      <a class="text-link" href="#decisiones">
        Leer las decisiones <Arrow down />
      </a>
    </div>
    <div class="technology-tags" aria-label="Tecnologías">
      {project.stack.map((item) => (
        <span>{item}</span>
      ))}
    </div>
  </header>
  <section class="case-demo-section" aria-labelledby="demo-title">
    <div class="case-demo-copy">
      <h2 id="demo-title">
        Pon la idea
        <br />a prueba.
      </h2>
      <p>{project.demo}</p>
    </div>
    <SoftwareLab initial={project.slug} uid={project.slug} single />
  </section>
  <article class="case-body" aria-label={`Caso de proyecto ${project.name}`}>
    <section class="case-article-section">
      <h2>El problema detrás de la interfaz.</h2>
      <div>
        <p>{project.context}</p>
        <ol class="data-flow" aria-label="Recorrido de datos">
          {project.flow.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
      </div>
    </section>
    <section class="case-article-section">
      <h2>Mi trabajo en el proyecto.</h2>
      <div>
        <p>{project.contribution}</p>
      </div>
    </section>
    <section class="case-article-section" id="decisiones">
      <h2>{project.decisionTitle}</h2>
      <div>
        <p>{project.decision}</p>
        <pre class="code-excerpt"><code>{project.code}</code></pre>
        <p class="code-note">{project.codeNote}</p>
      </div>
    </section>
    <section class="case-article-section">
      <h2>{project.failureTitle}</h2>
      <div>
        <p>{project.failure}</p>
      </div>
    </section>
    <section class="case-article-section">
      <h2>El límite y el siguiente paso.</h2>
      <div>
        <p>{project.tradeoff}</p>
      </div>
    </section>
    <section class="case-article-section">
      <h2>Qué comprobar en la demo.</h2>
      <div>
        <ul class="case-checks">
          {project.checks.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p class="code-note">
          Las respuestas numéricas de la demo representan el resultado de una acción local. No son
          peticiones a un servidor ni una prueba de seguridad del sistema original.
        </p>
      </div>
    </section>
    <section class="case-article-section">
      <h2>Del caso al código.</h2>
      <div>
        <p>{project.sourceNote}</p>
        <a
          class="source-link"
          href={`${project.repository}/blob/main/${project.sourcePath}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver {project.sourcePath} <Arrow />
        </a>
        <p class="code-note">
          El repositorio puede evolucionar. La demo de esta página es una implementación
          independiente creada para el portafolio.
        </p>
      </div>
    </section>
  </article>
  <a class="next-project" href={`/proyectos/${next.slug}/`}>
    <span>Continuar con otro caso</span>
    <strong>
      {next.name} <Arrow />
    </strong>
  </a>
</Layout>
