---
import Layout from '../../components/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import { projects } from '../../data/projects';
---

<Layout
  title="Proyectos Full-Stack: Laravel, Next.js y Django | Tulio Contreras"
  description="Casos de Bank App, SemBook y TaskDev: APIs, búsqueda de libros y permisos por roles. Código público, decisiones técnicas y demos de Tulio Contreras."
>
  <header class="index-intro">
    <h1>
      Proyectos.
      <br />
      Código con contexto.
    </h1>
    <p>
      Qué resuelve cada aplicación, cómo circulan sus datos y dónde están sus límites. Cada caso
      incluye una demo independiente y enlaces al código público.
    </p>
  </header>
  <section class="projects-index" aria-label="Proyectos seleccionados">
    {projects.map((project) => (
      <article class={`project-row theme-${project.theme}`}>
        <div class="project-route" aria-hidden="true">
          <span></span>
          <i></i>
          <span></span>
          <i></i>
          <span></span>
        </div>
        <div class="project-identity">
          <h2>
            <a href={`/proyectos/${project.slug}/`}>
              {project.name} <Arrow />
            </a>
          </h2>
          <p>{project.type}</p>
          <div class="technology-tags">
            {project.stack.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>
        <div class="project-argument">
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <div class="project-links">
            <a class="text-link" href={`/proyectos/${project.slug}/`}>
              Explorar {project.name} <Arrow />
            </a>
            <a href={project.repository} target="_blank" rel="noopener noreferrer">
              Código en GitHub <Arrow />
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>
  <section class="index-contact">
    <h2>Conoce el recorrido completo.</h2>
    <a class="text-link" href="/CV_Tulio_Contreras.pdf" target="_blank" rel="noopener">
      Ver mi CV <Arrow />
    </a>
  </section>
</Layout>
